    "dev:client": "npm run dev --workspace=apps/web-client",
    "migrate": "npm run migrate --workspace=server",
    "lint": "eslint .",
    "lint:errors": "eslint . --quiet"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0"
  }
