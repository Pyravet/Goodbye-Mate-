# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/goodbye_mate

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Phase 2+ placeholders (not used yet, kept here so the shape is visible early) ---
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
STRIPE_SECRET_KEY=
EWAY_API_KEY=
EWAY_API_PASSWORD=
# MSG91 (see server/src/integrations/sms/msg91.js for how these are used).
# Never paste the real value of MSG91_AUTH_KEY anywhere outside this .env
# file or your hosting provider's env var settings — it's a full-access
# key that can send unlimited SMS on your account's balance if leaked.
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=

